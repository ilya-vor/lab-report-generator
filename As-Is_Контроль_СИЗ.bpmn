<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Lab1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" processRef="Process_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" name="As-Is: контроль применения СИЗ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_4" name="Видеонаблюдение / служба безопасности">
        <bpmn:flowNodeRef>Task_Video</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Video</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VideoJurnal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Начальник цеха (руководство)">
        <bpmn:flowNodeRef>Task_Reshenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Vzyskanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Vzyskanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Служба охраны труда">
        <bpmn:flowNodeRef>Task_ProveritOT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstrPovt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Сварщик (рабочее место)">
        <bpmn:flowNodeRef>Task_Nadet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0" name="Мастер участка (сварочный участок)">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Instruktazh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Obrood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NaMeste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Utochnit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Proverka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SIZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zamechanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Jurnal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EndSmeny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Otchet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Peredat</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Начало смены" />
    <bpmn:userTask id="Task_Instruktazh" name="Провести инструктаж и выдать сменное задание" />
    <bpmn:userTask id="Task_Obrood" name="Обойти сварочный участок">
      <bpmn:incoming>Flow_0uz4p9y</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_NaMeste" name="Сварщик на рабочем месте?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>Flow_0uz4p9y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Utochnit" name="Уточнить местонахождение сварщика" />
    <bpmn:userTask id="Task_Proverka" name="Визуально проверить СИЗ: маска, перчатки, обувь" />
    <bpmn:userTask id="Task_Nadet" name="Надеть / поправить СИЗ" />
    <bpmn:exclusiveGateway id="Gw_SIZ" name="Все СИЗ надеты?" />
    <bpmn:userTask id="Task_Zamechanie" name="Сделать устное замечание" />
    <bpmn:userTask id="Task_Jurnal" name="Зафиксировать результат в журнале обхода (Excel)" />
    <bpmn:userTask id="Task_Video" name="Просмотреть архив видеонаблюдения (плановая проверка)" />
    <bpmn:exclusiveGateway id="Gw_Video" name="Обнаружено нарушение на видео?" />
    <bpmn:intermediateCatchEvent id="Event_EndSmeny" name="Конец смены">
      <bpmn:timerEventDefinition id="Timer_Event_EndSmeny" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_FixVideo" name="Зафиксировать нарушение по видео" />
    <bpmn:userTask id="Task_VideoJurnal" name="Добавить запись в журнал нарушений" />
    <bpmn:userTask id="Task_Otchet" name="Сформировать отчёт за смену (Excel)" />
    <bpmn:userTask id="Task_Peredat" name="Передать отчёт в службу охраны труда" />
    <bpmn:userTask id="Task_ProveritOT" name="Проверить и обобщить данные о нарушениях" />
    <bpmn:userTask id="Task_Reshenie" name="Принять решение о мерах воздействия" />
    <bpmn:exclusiveGateway id="Gw_Vzyskanie" name="Требуется дисциплинарное взыскание?" />
    <bpmn:userTask id="Task_Vzyskanie" name="Оформить дисциплинарное взыскание" />
    <bpmn:userTask id="Task_InstrPovt" name="Провести повторный инструктаж по СИЗ" />
    <bpmn:endEvent id="End_1" name="Отчёт сдан, смена закрыта" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Instruktazh" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Instruktazh" targetRef="Task_Obrood" />
    <bpmn:sequenceFlow id="Flow_0uz4p9y" sourceRef="Gw_NaMeste" targetRef="Task_Obrood" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Obrood" targetRef="Gw_NaMeste" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Utochnit" targetRef="Gw_NaMeste" />
    <bpmn:sequenceFlow id="F4" name="да" sourceRef="Gw_NaMeste" targetRef="Task_Proverka">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" name="нет" sourceRef="Gw_NaMeste" targetRef="Task_Utochnit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Nadet" targetRef="Task_Proverka" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Proverka" targetRef="Gw_SIZ" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Zamechanie" targetRef="Task_Nadet" />
    <bpmn:sequenceFlow id="F8" name="нет" sourceRef="Gw_SIZ" targetRef="Task_Zamechanie">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" name="да" sourceRef="Gw_SIZ" targetRef="Task_Jurnal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Jurnal" targetRef="Task_Video" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Video" targetRef="Gw_Video" />
    <bpmn:sequenceFlow id="F15" name="да" sourceRef="Gw_Video" targetRef="Task_FixVideo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" name="нет" sourceRef="Gw_Video" targetRef="Event_EndSmeny">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_VideoJurnal" targetRef="Event_EndSmeny" />
    <bpmn:sequenceFlow id="F19" sourceRef="Event_EndSmeny" targetRef="Task_Otchet" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_FixVideo" targetRef="Task_VideoJurnal" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Otchet" targetRef="Task_Peredat" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Peredat" targetRef="Task_ProveritOT" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ProveritOT" targetRef="Task_Reshenie" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Reshenie" targetRef="Gw_Vzyskanie" />
    <bpmn:sequenceFlow id="F24" name="да" sourceRef="Gw_Vzyskanie" targetRef="Task_Vzyskanie">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F25" name="нет" sourceRef="Gw_Vzyskanie" targetRef="Task_InstrPovt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Vzyskanie" targetRef="End_1" />
    <bpmn:sequenceFlow id="F27" sourceRef="Task_InstrPovt" targetRef="End_1" />
  </bpmn:process>
